{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizardjoe.local/schemas/directed_performance_preparation_v1.schema.json",
  "title": "DirectedPerformancePreparationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_slot", "context_request", "direction"],
  "properties": {
    "schema_version": {"const": 1},
    "source_slot": {"enum": ["main", "speech"]},
    "context_request": {"$ref": "#/$defs/contextRequest"},
    "direction": {"$ref": "#/$defs/direction"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contextRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "turn_id",
        "utterance_id",
        "media_id",
        "reply_sha256",
        "intent",
        "tone",
        "sensitivity",
        "urgency",
        "relational_stance",
        "pending_action_posture",
        "display_profile"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "turn_id": {"$ref": "#/$defs/id"},
        "utterance_id": {"$ref": "#/$defs/id"},
        "media_id": {"$ref": "#/$defs/id"},
        "reply_sha256": {"$ref": "#/$defs/hash"},
        "intent": {"$ref": "#/$defs/semanticIntent"},
        "tone": {
          "enum": ["direct", "focused", "measured", "neutral", "playful", "reflective", "serious", "warm"]
        },
        "sensitivity": {
          "enum": ["high_stakes", "ordinary", "restricted", "sensitive"]
        },
        "urgency": {"enum": ["critical", "high", "low", "normal"]},
        "relational_stance": {
          "enum": ["collaborative", "deferential", "firm", "instructive", "neutral", "supportive"]
        },
        "pending_action_posture": {
          "enum": ["approved", "denied", "failed", "none", "not_required", "pending", "stale"]
        },
        "display_profile": {"enum": ["desktop", "mobile"]}
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "direction_id",
        "direction_text",
        "intent",
        "duration_ms",
        "media_id",
        "media_sha256",
        "seed"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "direction_id": {
          "type": "string",
          "pattern": "^direction:[a-z0-9][a-z0-9._:-]{0,117}$"
        },
        "direction_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "intent": {"$ref": "#/$defs/directionIntent"},
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "media_id": {
          "type": "string",
          "pattern": "^media:sha256:[0-9a-f]{64}$"
        },
        "media_sha256": {"$ref": "#/$defs/hash"},
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "semanticIntent": {
      "enum": [
        "acknowledge", "caution", "celebrate", "characterful_neutral", "clarify",
        "degraded", "direct", "empathize", "explain", "external_action", "greet",
        "interrupt", "listen", "neutral", "no_decision", "none", "permission_posture",
        "present", "question", "reassure", "recall", "reference", "review", "settle",
        "speak", "think", "topic_reset", "transition", "wait"
      ]
    },
    "directionIntent": {
      "enum": [
        "acknowledge", "caution", "celebrate", "characterful_neutral", "clarify",
        "direct", "empathize", "explain", "greet", "interrupt", "listen",
        "present", "question", "reassure", "review", "settle", "speak",
        "transition", "wait"
      ]
    }
  }
}
