{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizardjoe.local/schemas/character_registry_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_character_id",
    "characters"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "default_character_id": {
      "$ref": "#/$defs/id"
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "character_id",
          "persona_id",
          "package",
          "package_sha256",
          "admission_sha256"
        ],
        "properties": {
          "character_id": {
            "$ref": "#/$defs/id"
          },
          "persona_id": {
            "$ref": "#/$defs/id"
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+$"
          },
          "package_sha256": {
            "$ref": "#/$defs/hash"
          },
          "admission_sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
